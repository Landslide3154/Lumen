import kotlin.Long;
import kotlin.collections.List;

CREATE TABLE categories(
    _id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    manga_order TEXT AS List<Long> NOT NULL,
    -- KMK -->
    hidden INTEGER NOT NULL DEFAULT 0,
    -- SyncYomi v2 keys categories by a stable uid and merges them by version
    version INTEGER NOT NULL DEFAULT 0,
    uid INTEGER NOT NULL DEFAULT 0
    -- KMK <--
);

-- Insert system category
INSERT OR IGNORE INTO categories(_id, name, sort, flags, manga_order, hidden, version, uid) VALUES (0, "", -1, 0, "", 0, 0, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON categories
BEGIN SELECT CASE
    WHEN old._id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT _id,name,sort,flags,hidden,
-- KMK -->
version,uid
-- KMK <--
FROM categories
WHERE _id = :id
LIMIT 1;

getCategories:
SELECT
_id AS id,
name,
sort AS `order`,
flags,
-- KMK -->
hidden,
version,
uid
-- KMK <--
FROM categories
ORDER BY sort;

getCategoriesByMangaId:
SELECT
C._id AS id,
C.name,
C.sort AS `order`,
C.flags,
-- KMK -->
C.hidden,
C.version,
C.uid
-- KMK <--
FROM categories C
JOIN mangas_categories MC
ON C._id = MC.category_id
WHERE MC.manga_id = :mangaId;

-- KMK -->
-- Give every user category a stable identity for SyncYomi v2. The system category keeps uid 0 so
-- every device maps it by its (empty) name.
CREATE TRIGGER insert_category_uid AFTER INSERT ON categories
WHEN new._id > 0
BEGIN
    UPDATE categories
    SET uid = CASE WHEN uid = 0 THEN abs(random()) ELSE uid END
    WHERE _id = new._id;
END;

-- Category edits are versioned so a rename or a reorder propagates instead of losing the tie.
CREATE TRIGGER update_category_version AFTER UPDATE ON categories
WHEN new.name != old.name OR new.sort != old.sort OR new.flags != old.flags OR new.hidden != old.hidden
BEGIN
    UPDATE categories
    SET version = version + 1
    WHERE _id = new._id;
END;
-- KMK <--

insert:
INSERT INTO categories(name, sort, flags, manga_order, hidden, version, uid)
VALUES (:name, :order, :flags, "", :hidden, :version, :uid);

delete:
DELETE FROM categories
WHERE _id = :categoryId;

update:
UPDATE categories
SET name = coalesce(:name, name),
    sort = coalesce(:order, sort),
    flags = coalesce(:flags, flags),
    -- KMK -->
    hidden = coalesce(:hidden, hidden),
    version = coalesce(:version, version),
    uid = coalesce(:uid, uid)
    -- KMK <--
WHERE _id = :categoryId;

updateAllFlags:
UPDATE categories SET
flags = coalesce(?, flags);

selectLastInsertedRowId:
SELECT last_insert_rowid();
